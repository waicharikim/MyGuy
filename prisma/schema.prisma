generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ThreadStatus {
  OPEN
  CLOSED
  ESCALATED
}

enum DecisionPass {
  INTAKE
  SKEPTIC
  GROUND
  CLOSE
}

enum MessageDirection {
  IN
  OUT
  SYSTEM
}

enum FollowupStatus {
  PENDING
  PROCESSING
  SENT
  CANCELLED
  FAILED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum HumanQueryStatus {
  OPEN
  ANSWERED
  CANCELLED
}

enum HumanQuerySource {
  USER
  OPERATOR
  NONE
}

enum EscalationStatus {
  OPEN
  RESOLVED
  CANCELLED
}

enum KnowledgeCandidateStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AgentInteractionStatus {
  REQUESTED
  ANSWERED
  REJECTED
  EXPIRED
}

enum DecisionRecordStatus {
  OPEN
  AWAITING_HUMAN
  RESOLVED
  ESCALATED
}

enum DecisionOutcomeStatus {
  SUCCESSFUL
  PARTIAL
  UNSUCCESSFUL
  NO_ACTION
  UNCLEAR
}

enum DecisionOutcomeSource {
  USER
  OPERATOR
}

model User {
  id        String   @id @default(uuid())
  phone     String   @unique
  createdAt DateTime @default(now())

  profile UserProfile?
  threads Thread[]
  tasks   Task[]
  notes   Note[]
  payments Payment[]
  humanQueries HumanQuery[]
  escalations Escalation[]
  knowledgeCandidates KnowledgeCandidate[]
  decisionRecords DecisionRecord[]
}

model UserProfile {
  id                 String   @id @default(uuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id])
  summary            String   @default("")
  values             String[] @default([])
  recurringConcerns  String[] @default([])
  pastDecisions      Json[]   @default([])
  communicationStyle String?
  updatedAt          DateTime @updatedAt
}

model Thread {
  id                       String       @id @default(uuid())
  userId                   String
  user                     User         @relation(fields: [userId], references: [id])
  status                   ThreadStatus  @default(OPEN)
  currentPass              DecisionPass  @default(INTAKE)
  awaitingReply            Boolean      @default(false)
  awaitingHuman            Boolean      @default(false)
  awaitingSource           HumanQuerySource @default(USER)
  pendingCloseConfirmation Boolean      @default(false)
  outcomeRequestedAt       DateTime?
  followupCount            Int          @default(0)
  known                    String[]     @default([])
  open                     String[]     @default([])
  leaning                  String?
  skepticArgument          String?
  decisionSummary          String?
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt
  closedAt                 DateTime?

  messages              Message[]
  followups             ScheduledFollowup[]
  tasks                 Task[]
  notes                 Note[]
  groundingEvidence     GroundingEvidence[]
  humanQueries          HumanQuery[]
  escalations           Escalation[]
  knowledgeCandidates   KnowledgeCandidate[]
  checkpoints           GraphCheckpoint[]
  agentInteractions     AgentInteraction[]
  payments              Payment[]
  decisionRecords       DecisionRecord[]

  @@index([userId, status, updatedAt])
}

model DecisionRecord {
  id                 String                @id @default(uuid())
  userId             String
  user               User                  @relation(fields: [userId], references: [id])
  threadId           String                @unique
  thread             Thread                @relation(fields: [threadId], references: [id])
  matter             String               @default("")
  status             DecisionRecordStatus  @default(OPEN)
  decisionSummary    String               @default("")
  goal               String               @default("")
  recommendedOption  String               @default("")
  confidence         Float                @default(0)
  risks              String[]             @default([])
  assumptions        String[]             @default([])
  evidenceRefs       String[]             @default([])
  humanInputs        String[]             @default([])
  escalationReason   String?
  outcomeStatus      DecisionOutcomeStatus?
  outcomeNotes       String?
  outcomeSource      DecisionOutcomeSource?
  outcomeAt          DateTime?
  outcomeClassificationNotes String?
  outcomeClassifiedAt DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([userId, status, updatedAt])
}

model InboundReceipt {
  id         String   @id @default(uuid())
  channel    String
  externalId String
  phone      String
  text       String
  processedAt DateTime?
  createdAt  DateTime @default(now())

  @@unique([channel, externalId])
}

model Message {
  id          String          @id @default(uuid())
  threadId    String
  thread      Thread          @relation(fields: [threadId], references: [id])
  direction   MessageDirection
  pass        DecisionPass?
  channel     String          @default("whatsapp")
  externalId  String?
  content     String
  metadata    Json?
  createdAt   DateTime        @default(now())

  @@unique([channel, externalId])
  @@index([threadId, createdAt])
}

model GraphCheckpoint {
  id          String      @id @default(uuid())
  threadId    String
  thread      Thread      @relation(fields: [threadId], references: [id])
  graphThreadId String
  pass        DecisionPass
  state       Json
  createdAt   DateTime    @default(now())

  @@index([threadId, createdAt])
  @@unique([threadId, graphThreadId, pass, createdAt])
}

model ScheduledFollowup {
  id             String         @id @default(uuid())
  threadId       String
  thread         Thread         @relation(fields: [threadId], references: [id])
  runAt          DateTime
  promptContext  String
  idempotencyKey String         @unique
  status         FollowupStatus @default(PENDING)
  attempts       Int            @default(0)
  sentAt         DateTime?
  createdAt      DateTime       @default(now())

  @@index([status, runAt])
}

model GroundingEvidence {
  id          String   @id @default(uuid())
  threadId    String
  thread      Thread   @relation(fields: [threadId], references: [id])
  claim       String
  searchQuery String
  sourceUrl   String
  sourceTitle String?
  finding     String
  confidence  Float?
  retrievedAt DateTime @default(now())

  @@index([threadId, retrievedAt])
}

model HumanQuery {
  id              String           @id @default(uuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id])
  threadId        String
  thread          Thread           @relation(fields: [threadId], references: [id])
  matter          String
  question        String
  knownContext    String
  reason          String
  source          HumanQuerySource @default(USER)
  status          HumanQueryStatus @default(OPEN)
  answer          String?
  messages        HumanQueryMessage[]
  createdAt       DateTime         @default(now())
  answeredAt      DateTime?

  @@index([threadId, status])
}

model HumanQueryMessage {
  id           String     @id @default(uuid())
  humanQueryId String
  humanQuery   HumanQuery @relation(fields: [humanQueryId], references: [id])
  direction    MessageDirection
  content      String
  createdAt    DateTime   @default(now())
}

model Escalation {
  id         String           @id @default(uuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id])
  threadId   String
  thread     Thread           @relation(fields: [threadId], references: [id])
  reason     String
  status     EscalationStatus @default(OPEN)
  createdAt  DateTime         @default(now())
  resolvedAt DateTime?

  messages EscalationMessage[]
  @@index([status, createdAt])
}

model EscalationMessage {
  id           String          @id @default(uuid())
  escalationId String
  escalation   Escalation      @relation(fields: [escalationId], references: [id])
  direction    MessageDirection
  content      String
  createdAt    DateTime        @default(now())
}

model KnowledgeCandidate {
  id          String                    @id @default(uuid())
  userId      String
  user        User                      @relation(fields: [userId], references: [id])
  threadId    String
  thread      Thread                    @relation(fields: [threadId], references: [id])
  proposition String
  evidence    Json?
  status      KnowledgeCandidateStatus  @default(PENDING)
  reviewedAt  DateTime?
  reviewedBy  String?
  createdAt   DateTime                  @default(now())

  @@index([status, createdAt])
}

model Note {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  threadId  String?
  thread    Thread?  @relation(fields: [threadId], references: [id])
  content   String
  createdAt DateTime @default(now())
}

model Payment {
  id                String        @id @default(uuid())
  userId            String
  user               User         @relation(fields: [userId], references: [id])
  threadId          String?       @unique
  thread            Thread?       @relation(fields: [threadId], references: [id])
  amount            Int
  status            PaymentStatus @default(PENDING)
  checkoutRequestId String?       @unique
  mpesaReceipt      String?
  originalMessage   String
  externalMessageId String? @unique
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model Task {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  threadId    String?
  thread      Thread?   @relation(fields: [threadId], references: [id])
  description String
  dueAt       DateTime?
  status      String    @default("open")
  createdAt   DateTime  @default(now())
}

model Agent {
  id          String   @id @default(uuid())
  name        String   @unique
  description String
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  capabilities AgentCapability[]
  requestedInteractions AgentInteraction[] @relation("requesterAgent")
  receivedInteractions AgentInteraction[] @relation("responderAgent")
}

model AgentCapability {
  id          String   @id @default(uuid())
  agentId     String
  agent       Agent    @relation(fields: [agentId], references: [id])
  name        String
  description String
  enabled     Boolean  @default(true)

  @@unique([agentId, name])
}

model AgentPermission {
  id             String @id @default(uuid())
  requesterAgentId String
  responderAgentId String
  capability      String
  allowed         Boolean @default(false)

  @@unique([requesterAgentId, responderAgentId, capability])
}

model AgentInteraction {
  id            String                   @id @default(uuid())
  requesterId   String
  requester     Agent                    @relation("requesterAgent", fields: [requesterId], references: [id])
  responderId   String
  responder     Agent                    @relation("responderAgent", fields: [responderId], references: [id])
  threadId      String?
  thread        Thread?                  @relation(fields: [threadId], references: [id])
  capability    String
  request       Json
  response      Json?
  status        AgentInteractionStatus   @default(REQUESTED)
  createdAt     DateTime                 @default(now())
  completedAt   DateTime?

  messages AgentInteractionMessage[]
}

model AgentInteractionMessage {
  id            String            @id @default(uuid())
  interactionId String
  interaction   AgentInteraction  @relation(fields: [interactionId], references: [id])
  direction     MessageDirection
  content       String
  createdAt     DateTime          @default(now())
}
